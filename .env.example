# Server only. Never expose this key in public map URLs or browser bundles.
OCM_API_KEY=
# OSRM-compatible service; omit to keep routing explicitly disabled.
ROUTING_BASE_URL=
RATE_LIMIT_PER_MINUTE=60
# Exact browser origins allowed to call the live backend, comma-separated.
CORS_ALLOWED_ORIGINS=https://raafen.github.io
# Optional Pages BUILD setting, not a provider credential. HTTPS backend only
# (loopback HTTP is accepted for local integration). Default is production Vercel.
# API_BASE_URL=https://ev-charging-finder-nine.vercel.app/
# Optional PUBLIC, licensed browser sources. These URLs must contain no secrets.
MAP_TERRAIN_URL=
MAP_SATELLITE_URL=
